require duckdb_graphar

statement ok
SET autoinstall_known_extensions=1;

statement ok
SET autoload_known_extensions=1;

statement ok
LOAD parquet;

query I
SELECT COUNT(*) FROM read_hop('{WORKING_DIRECTORY}/data/snap-musae-github/graphar/Git.graph.yaml', src='Person', type='knows', dst='Person', vid=10);
----
17457

query I
SELECT COUNT(*) FROM read_hop('{WORKING_DIRECTORY}/data/snap-musae-github/graphar/Git.graph.yaml', src='Person', type='knows', dst='Person', vids=[1, 10]);
----
18247

# Direct EdgeInfo.yaml path (no src/type/dst) must be routed to path mode
query I
SELECT COUNT(*) FROM read_hop('{WORKING_DIRECTORY}/data/snap-musae-github/graphar/Person_knows_Person.edge.yaml', vid=10);
----
17457

query I
SELECT COUNT(*) FROM read_hop('{WORKING_DIRECTORY}/data/snap-musae-github/graphar/Person_knows_Person.edge.yaml', vids=[1, 10]);
----
18247


statement ok
ATTACH '{WORKING_DIRECTORY}/data/snap-musae-github/graphar/Git.graph.yaml' as git(type duckdb_graphar);

query I
SELECT COUNT(*) FROM read_hop('Person_knows_Person', vid=10);
----
17457

query I
SELECT COUNT(*) FROM read_hop('Person_knows_Person', vids=[1, 10]);
----
18247

# Regression test: an explicit 'catalog' name must be honored. Before the fix,
# SetBindDataByEdgeTable looked up Catalog::GetCatalog(empty identifier), which
# resolved to the default catalog and silently ignored the requested catalog
# name -- so a nonexistent catalog would (incorrectly) succeed. It must error.
statement error
SELECT COUNT(*) FROM read_hop('Person_knows_Person', catalog='nonexistent_db', vid=10);
----
Binder Error: Catalog "nonexistent_db" does not exist!

# A GraphInfo.yaml passed as a direct edge path must produce a clear error,
# not a segmentation fault.
statement error
SELECT * FROM read_hop('{WORKING_DIRECTORY}/data/snap-musae-github/graphar/Git.graph.yaml', vid=10);
----
Could not load edge info from path
