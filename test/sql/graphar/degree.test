require duckdb_graphar

statement ok
SET autoinstall_known_extensions=1;

statement ok
SET autoload_known_extensions=1;

statement ok
LOAD parquet;

# Basic select over the git dataset: one row per vertex, 3 columns.
query III
SELECT * FROM degree('{WORKING_DIRECTORY}/data/git/Git.yaml', src='Person', type='knows', dst='Person') WHERE _graphArVertexIndex=5;
----
5
1
1

query III
SELECT * FROM degree('{WORKING_DIRECTORY}/data/git/Git.yaml', src='Person', type='knows', dst='Person') WHERE _graphArVertexIndex=42;
----
42
55
55

query I
SELECT COUNT(*) FROM degree('{WORKING_DIRECTORY}/data/git/Git.yaml', src='Person', type='knows', dst='Person');
----
37700

# Projection pushdown: only out_degree requested (dst offset file not read).
query I
SELECT out_degree FROM degree('{WORKING_DIRECTORY}/data/git/Git.yaml', src='Person', type='knows', dst='Person') WHERE _graphArVertexIndex=10;
----
66

query I
SELECT in_degree FROM degree('{WORKING_DIRECTORY}/data/git/Git.yaml', src='Person', type='knows', dst='Person') WHERE _graphArVertexIndex=10;
----
66

query I
SELECT _graphArVertexIndex FROM degree('{WORKING_DIRECTORY}/data/git/Git.yaml', src='Person', type='knows', dst='Person') WHERE _graphArVertexIndex=7;
----
7

# Single equality filter pushdown.
query III
SELECT * FROM degree('{WORKING_DIRECTORY}/data/git/Git.yaml', src='Person', type='knows', dst='Person') WHERE _graphArVertexIndex=5;
----
5
1
1

# Batch filter pushdown (IN).
query II
SELECT _graphArVertexIndex, out_degree FROM degree('{WORKING_DIRECTORY}/data/git/Git.yaml', src='Person', type='knows', dst='Person') WHERE _graphArVertexIndex IN (5, 42) ORDER BY _graphArVertexIndex;
----
5
1
42
55

# Batch filter pushdown (list_contains).
query II
SELECT _graphArVertexIndex, out_degree FROM degree('{WORKING_DIRECTORY}/data/git/Git.yaml', src='Person', type='knows', dst='Person') WHERE list_contains([3, 10, 22], _graphArVertexIndex) ORDER BY _graphArVertexIndex;
----
3
5
10
66
22
7

# max(out_degree).
query I
SELECT max(out_degree) FROM degree('{WORKING_DIRECTORY}/data/git/Git.yaml', src='Person', type='knows', dst='Person');
----
9458

# max(in_degree).
query I
SELECT max(in_degree) FROM degree('{WORKING_DIRECTORY}/data/git/Git.yaml', src='Person', type='knows', dst='Person');
----
9458